{
  "description": "On the first prompt of each Claude Code chat, injects the Cortex context that matches it (cortex_prime), and serves it again after the chat is compacted, resumed or cleared; before a compaction, asks to record durable items first. When a Claude Code session ends, closes Cortex sessions whose server has exited (or idle over 2 h). After a web, browser or other non-Cortex MCP tool, marks the vault so the next Cortex write counts as exposed.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cortex prime-hook; exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "cortex prime-hook; exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cortex prime-hook; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cortex session sweep; exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?!mcp__(cortex|plugin_cortex_cortex|ccd_[^_]*|visualize|scheduled-tasks|savvy-progress)__)(WebFetch|WebSearch|mcp__.+)$",
        "hooks": [
          {
            "type": "command",
            "command": "cortex taint; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
