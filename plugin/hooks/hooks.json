{
  "description": "On the first prompt of each Claude Code chat, injects the Keepfold context that matches it (keepfold_prime), and serves it again after the chat is compacted, resumed or cleared; before a compaction, asks to record durable items first. When a Claude Code session ends, closes Keepfold sessions whose server has exited (or idle over 2 h). After a web, browser or other non-Keepfold MCP tool, marks the vault so the next Keepfold write counts as exposed.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "keepfold prime-hook; exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "keepfold prime-hook; exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "keepfold prime-hook; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "keepfold session sweep; exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?!mcp__(keepfold|plugin_keepfold_keepfold|ccd_[^_]*|visualize|scheduled-tasks|savvy-progress)__)(WebFetch|WebSearch|mcp__.+)$",
        "hooks": [
          {
            "type": "command",
            "command": "keepfold taint; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
