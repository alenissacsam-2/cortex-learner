{
  "manifest_version": 3,
  "name": "Cortex capture",
  "version": "0.2.0",
  "description": "Sends what you read to your own Cortex receiver on this computer (127.0.0.1) and nowhere else.",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": ["tabs", "storage", "idle", "scripting", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Cortex capture", "default_popup": "popup.html" }
}
