{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.alenissacsem-2/keepfold",
  "title": "Keepfold",
  "description": "One memory for all your AI apps, kept as plain Markdown files on your own computer",
  "repository": {
    "url": "https://github.com/alenissacsem-2/keepfold",
    "source": "github"
  },
  "version": "0.6.3",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "keepfold",
      "version": "0.6.3",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
